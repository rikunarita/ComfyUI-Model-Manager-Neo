# Vendored prebuilt ZipNN core binaries are true binaries: never apply
# end-of-line conversion or textual diffs to them.
*.so binary
*.so -text -diff
*.pyd binary
*.dll binary
*.dylib binary

# Rust sources are LF-normalized in the repository and checked out as LF on
# every platform (GitHub Windows runners default to core.autocrlf=true, which
# otherwise flips them to CRLF and breaks the `cargo fmt --check` gate).
*.rs text eol=lf
