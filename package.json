{
  "name": "comfyui-model-manager-neo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "pnpm install --frozen-lockfile && vite",
    "build": "pnpm install --frozen-lockfile && vite build",
    "build:clean": "rm -rf web && pnpm install --frozen-lockfile && vite build",
    "rebuild": "rm -rf node_modules web && pnpm install --frozen-lockfile && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "deps": "depcruise src",
    "deps:graph": "depcruise src --output-type dot --output-to dependency_graph.svg",
    "py:lint": "ruff check py __init__.py",
    "py:lint:fix": "ruff check --fix py __init__.py",
    "py:format": "ruff format py __init__.py",
    "py:format:check": "ruff format --check py __init__.py",
    "rs:fmt": "cd native && cargo fmt --all",
    "rs:fmt:check": "cd native && cargo fmt --all -- --check",
    "rs:lint": "cd native && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rs:test": "cd native && cargo test --workspace --exclude mm-core && cargo test -p mm-core --no-default-features",
    "rs:build": "cd native && cargo build --release -p mm-core",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dead:type-aware": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes",
    "fallow:similar-code": "fallow similar-code",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit",
    "fallow:fix:dry": "fallow fix --dry-run",
    "fallow:fix": "fallow fix --yes",
    "fallow:list": "fallow list",
    "prepare": "husky"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.49.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "dependency-cruiser": "18.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vue": "^10.11.0",
    "fallow": "^3.27.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "markdown-it": "^15.0.1",
    "markdown-it-metadata-block": "^1.0.6",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-sonner": "^2.0.9",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,html}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix --force-exclude",
      "ruff format --force-exclude"
    ]
  }
}
