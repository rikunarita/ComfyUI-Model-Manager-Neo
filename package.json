{
  "name": "comfyui-model-manager-neo",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm install --frozen-lockfile && vite",
    "build": "pnpm install --frozen-lockfile && vite build",
    "build:clean": "rm -rf web && pnpm install --frozen-lockfile && vite build",
    "rebuild": "rm -rf node_modules web && pnpm install --frozen-lockfile && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.49.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@primeuix/styled": "^0.3.0",
    "@primeuix/utils": "^0.3.0",
    "@primevue/themes": "4.2.5",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "markdown-it": "^15.0.1",
    "markdown-it-metadata-block": "^1.0.6",
    "primevue": "4.2.5",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-sonner": "^2.0.9",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "./**/*.{js,ts,tsx,vue}": [
      "prettier --write"
    ]
  }
}
