{
  "name": "comfyui-model-manager-neo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "pnpm install --frozen-lockfile && vite",
    "build": "pnpm install --frozen-lockfile && vite build",
    "build:clean": "rm -rf web && pnpm install --frozen-lockfile && vite build",
    "rebuild": "rm -rf node_modules web && pnpm install --frozen-lockfile && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "verify:py": "python3 harness/py_probe.py",
    "verify:e2e": "node harness/e2e.mjs"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.49.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "markdown-it": "^15.0.1",
    "markdown-it-metadata-block": "^1.0.6",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-sonner": "^2.0.9",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml,html}": [
      "prettier --write"
    ]
  }
}
