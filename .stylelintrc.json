{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "plugin",
          "reference",
          "config",
          "tailwind",
          "apply"
        ]
      }
    ],
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": [
          "appearance",
          "backdrop-filter",
          "-webkit-appearance",
          "-webkit-backdrop-filter"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.vue"],
      "customSyntax": "postcss-html"
    }
  ],
  "ignoreFiles": ["web/**", "dist/**", "node_modules/**", "third_party/**"]
}
